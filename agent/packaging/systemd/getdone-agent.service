[Unit]
Description=GetDone Universal Compute Node Agent
Documentation=https://github.com/DMART19/GetDone
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=getdone-agent
Group=getdone-agent
ExecStart=/usr/local/bin/getdone-agent
Restart=on-failure
RestartSec=5s
EnvironmentFile=-/etc/getdone-agent/config.env
StateDirectory=getdone-agent
StateDirectoryMode=0700
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
ReadWritePaths=/var/lib/getdone-agent

[Install]
WantedBy=multi-user.target
