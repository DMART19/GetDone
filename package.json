{
  "name": "getdone-ufo-v2",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "verify:secrets": "node scripts/verify-no-secrets.mjs",
    "verify:architecture": "node scripts/verify-architecture.mjs",
    "release:generate": "node scripts/generate-release-artifacts.mjs",
    "verify:release": "node scripts/verify-release-artifacts.mjs",
    "verify:coverage": "npm run test:coverage && npm run verify:module-coverage",
    "verify:contract-versions": "node scripts/verify-contract-versions.mjs",
    "verify:module-coverage": "node scripts/verify-control-plane-coverage.mjs",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test --project=mobile-chromium",
    "verify:dependencies": "node scripts/verify-dependencies.mjs",
    "db:migrate": "node scripts/migrate-postgres.mjs",
    "db:verify-production": "node scripts/verify-postgres-production.mjs",
    "db:record-backup": "node scripts/record-postgres-backup-evidence.mjs",
    "auth:provision-owner": "node scripts/provision-owner-session.mjs",
    "db:test-integration": "node scripts/test-postgres-integration.mjs",
    "production:bootstrap": "node scripts/bootstrap-production.mjs",
    "verify:production-runtime": "node scripts/verify-production-runtime.mjs",
    "ai:accept-staging": "vitest run lib/ai-gateway/openrouter-staging.acceptance.test.ts",
    "gmail:accept-staging": "vitest run lib/execution/gmail-live-staging.acceptance.test.ts",
    "slack:accept-staging": "vitest run lib/execution/slack-live-staging.acceptance.test.ts",
    "http:accept-staging": "vitest run lib/execution/configured-http-live-staging.acceptance.test.ts",
    "build:worker": "tsc -p tsconfig.worker.json",
    "start:worker": "node --require ./scripts/register-worker-alias.cjs dist-worker/lib/execution/job-worker-entry.js",
    "worker:test-crash-restart": "vitest run lib/execution/worker-crash-restart.integration.test.ts",
    "worker:test-backpressure": "vitest run lib/execution/queue-backpressure-postgres.integration.test.ts",
    "build:worker-acceptance": "tsc -p tsconfig.worker-acceptance.json"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "next": "15.5.25",
    "react": "19.1.2",
    "react-dom": "19.1.2",
    "zod": "3.25.76",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.0.0",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.25",
    "typescript": "5.7.2",
    "vitest": "3.2.7",
    "@types/pg": "8.23.1"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
