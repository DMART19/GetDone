{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "getdone"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Secret",
      "metadata": {
        "name": "getdone-runtime-secrets",
        "namespace": "getdone"
      },
      "type": "Opaque",
      "data": {
        "DATABASE_URL": "__DATABASE_URL_B64__",
        "GETDONE_INTERNAL_WORKER_TOKEN": "__GETDONE_INTERNAL_WORKER_TOKEN_B64__",
        "OPENROUTER_API_KEY": "__OPENROUTER_API_KEY_B64__",
        "GETDONE_CREDENTIAL_BROKER_TOKEN": "__GETDONE_CREDENTIAL_BROKER_TOKEN_B64__"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "getdone-runtime-config",
        "namespace": "getdone"
      },
      "data": {
        "GETDONE_RUNTIME_ENV": "production",
        "NEXT_PUBLIC_APP_ENV": "production",
        "GETDONE_DATA_MODE": "authoritative",
        "GETDONE_DB_RUNTIME_ROLE": "getdone_tenant_runtime",
        "GETDONE_BACKUP_MAX_AGE_HOURS": "24",
        "GETDONE_AUTH_COOKIE_SECURE": "true",
        "GETDONE_WEBAUTHN_RP_ID": "__PUBLIC_HOST__",
        "GETDONE_WEBAUTHN_ORIGINS": "https://__PUBLIC_HOST__",
        "OPENROUTER_BASE_URL": "__OPENROUTER_BASE_URL__",
        "GETDONE_AI_MODEL_PROFILES_JSON": "__AI_MODEL_PROFILES_JSON__",
        "GETDONE_AI_ROUTING_POLICY_JSON": "__AI_ROUTING_POLICY_JSON__",
        "OPENROUTER_CANARY_ENABLED": "true",
        "OPENROUTER_CANARY_MODEL": "__OPENROUTER_CANARY_MODEL__",
        "GETDONE_OBSERVABILITY_ENABLED": "true",
        "GETDONE_OTEL_EXPORTER_OTLP_ENDPOINT": "__OTEL_ENDPOINT__",
        "GETDONE_HTTP_ACTIONS_JSON": "__HTTP_ACTIONS_JSON__",
        "GETDONE_WEBHOOK_ACTIONS_JSON": "__WEBHOOK_ACTIONS_JSON__",
        "GETDONE_GMAIL_ACTIONS_JSON": "__GMAIL_ACTIONS_JSON__",
        "GETDONE_SLACK_ACTIONS_JSON": "__SLACK_ACTIONS_JSON__",
        "GETDONE_CRM_ACTIONS_JSON": "__CRM_ACTIONS_JSON__",
        "GETDONE_GITHUB_ACTIONS_JSON": "__GITHUB_ACTIONS_JSON__",
        "GETDONE_ANALYTICS_SOURCES_JSON": "__ANALYTICS_SOURCES_JSON__",
        "GETDONE_CALENDAR_ACTIONS_JSON": "__CALENDAR_ACTIONS_JSON__",
        "GETDONE_CREDENTIAL_DELIVERY_URL": "__CREDENTIAL_DELIVERY_URL__",
        "GETDONE_PROVIDER_CONCURRENCY_LIMIT": "4",
        "GETDONE_PROVIDER_CONCURRENCY_LEASE_SECONDS": "120",
        "GETDONE_PROVIDER_CONCURRENCY_LIMITS_JSON": "__PROVIDER_LIMITS_JSON__",
        "GETDONE_JOB_BATCH_SIZE": "10",
        "GETDONE_JOB_CONCURRENCY": "4",
        "GETDONE_JOB_QUEUE_DEPTH_LIMIT": "1000",
        "GETDONE_JOB_COMPANY_QUEUE_DEPTH_LIMIT": "250",
        "GETDONE_JOB_LEASE_SECONDS": "60",
        "GETDONE_JOB_HEARTBEAT_SECONDS": "20",
        "GETDONE_JOB_POLL_INTERVAL_MS": "1000",
        "GETDONE_JOB_ERROR_BACKOFF_MS": "5000",
        "GETDONE_JOB_RECOVERY_LIMIT": "50",
        "GETDONE_JOB_MAX_ATTEMPTS": "5",
        "GETDONE_JOB_RECOVERY_DELAY_MS": "1000",
        "GETDONE_JOB_RETRY_BASE_DELAY_MS": "1000"
      }
    },
    {
      "apiVersion": "batch/v1",
      "kind": "Job",
      "metadata": {
        "name": "getdone-db-migrate",
        "namespace": "getdone",
        "labels": {
          "app.kubernetes.io/name": "getdone",
          "app.kubernetes.io/component": "migration"
        }
      },
      "spec": {
        "backoffLimit": 2,
        "ttlSecondsAfterFinished": 86400,
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "getdone",
              "app.kubernetes.io/component": "migration"
            }
          },
          "spec": {
            "restartPolicy": "Never",
            "serviceAccountName": "getdone-runtime",
            "securityContext": {
              "runAsNonRoot": true,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "migrate",
                "image": "__WEB_IMAGE__",
                "imagePullPolicy": "IfNotPresent",
                "command": [
                  "npm",
                  "run",
                  "db:migrate"
                ],
                "envFrom": [
                  {
                    "configMapRef": {
                      "name": "getdone-runtime-config"
                    }
                  },
                  {
                    "secretRef": {
                      "name": "getdone-runtime-secrets"
                    }
                  }
                ],
                "env": [
                  {
                    "name": "GETDONE_PROCESS_ROLE",
                    "value": "web"
                  }
                ],
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "512Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {}
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {
        "name": "getdone-runtime",
        "namespace": "getdone"
      },
      "automountServiceAccountToken": false
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "getdone-web",
        "namespace": "getdone",
        "labels": {
          "app.kubernetes.io/name": "getdone",
          "app.kubernetes.io/component": "web"
        }
      },
      "spec": {
        "replicas": 2,
        "strategy": {
          "type": "RollingUpdate",
          "rollingUpdate": {
            "maxUnavailable": 0,
            "maxSurge": 1
          }
        },
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "getdone",
            "app.kubernetes.io/component": "web"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "getdone",
              "app.kubernetes.io/component": "web"
            }
          },
          "spec": {
            "serviceAccountName": "getdone-runtime",
            "automountServiceAccountToken": false,
            "terminationGracePeriodSeconds": 60,
            "securityContext": {
              "runAsNonRoot": true,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "web",
                "image": "__WEB_IMAGE__",
                "imagePullPolicy": "IfNotPresent",
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 3000
                  }
                ],
                "envFrom": [
                  {
                    "configMapRef": {
                      "name": "getdone-runtime-config"
                    }
                  },
                  {
                    "secretRef": {
                      "name": "getdone-runtime-secrets"
                    }
                  }
                ],
                "env": [
                  {
                    "name": "GETDONE_PROCESS_ROLE",
                    "value": "web"
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/api/control/health",
                    "port": "http"
                  },
                  "initialDelaySeconds": 10,
                  "periodSeconds": 10,
                  "timeoutSeconds": 3,
                  "failureThreshold": 6
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/api/health",
                    "port": "http"
                  },
                  "initialDelaySeconds": 30,
                  "periodSeconds": 15,
                  "timeoutSeconds": 3,
                  "failureThreshold": 4
                },
                "startupProbe": {
                  "httpGet": {
                    "path": "/api/health",
                    "port": "http"
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 3,
                  "failureThreshold": 24
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "250m",
                    "memory": "256Mi"
                  },
                  "limits": {
                    "cpu": "1000m",
                    "memory": "1Gi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  },
                  {
                    "name": "next-cache",
                    "mountPath": "/app/.next/cache"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {}
              },
              {
                "name": "next-cache",
                "emptyDir": {}
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "getdone-web",
        "namespace": "getdone"
      },
      "spec": {
        "selector": {
          "app.kubernetes.io/name": "getdone",
          "app.kubernetes.io/component": "web"
        },
        "ports": [
          {
            "name": "http",
            "port": 80,
            "targetPort": "http"
          }
        ],
        "type": "ClusterIP"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "getdone-worker",
        "namespace": "getdone",
        "labels": {
          "app.kubernetes.io/name": "getdone",
          "app.kubernetes.io/component": "worker"
        }
      },
      "spec": {
        "replicas": 2,
        "strategy": {
          "type": "RollingUpdate",
          "rollingUpdate": {
            "maxUnavailable": 0,
            "maxSurge": 1
          }
        },
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "getdone",
            "app.kubernetes.io/component": "worker"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "getdone",
              "app.kubernetes.io/component": "worker"
            }
          },
          "spec": {
            "serviceAccountName": "getdone-runtime",
            "automountServiceAccountToken": false,
            "terminationGracePeriodSeconds": 120,
            "securityContext": {
              "runAsNonRoot": true,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "worker",
                "image": "__WORKER_IMAGE__",
                "imagePullPolicy": "IfNotPresent",
                "ports": [
                  {
                    "name": "health",
                    "containerPort": 3001
                  }
                ],
                "envFrom": [
                  {
                    "configMapRef": {
                      "name": "getdone-runtime-config"
                    }
                  },
                  {
                    "secretRef": {
                      "name": "getdone-runtime-secrets"
                    }
                  }
                ],
                "env": [
                  {
                    "name": "GETDONE_PROCESS_ROLE",
                    "value": "job-worker"
                  },
                  {
                    "name": "GETDONE_JOB_WORKER_ID",
                    "valueFrom": {
                      "fieldRef": {
                        "fieldPath": "metadata.name"
                      }
                    }
                  },
                  {
                    "name": "GETDONE_JOB_WORKER_HEALTH_HOST",
                    "value": "0.0.0.0"
                  },
                  {
                    "name": "GETDONE_JOB_WORKER_HEALTH_PORT",
                    "value": "3001"
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/readyz",
                    "port": "health"
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 10,
                  "timeoutSeconds": 3,
                  "failureThreshold": 6
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/livez",
                    "port": "health"
                  },
                  "initialDelaySeconds": 20,
                  "periodSeconds": 15,
                  "timeoutSeconds": 3,
                  "failureThreshold": 4
                },
                "startupProbe": {
                  "httpGet": {
                    "path": "/livez",
                    "port": "health"
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 3,
                  "failureThreshold": 24
                },
                "lifecycle": {
                  "preStop": {
                    "exec": {
                      "command": [
                        "/bin/sh",
                        "-c",
                        "sleep 10"
                      ]
                    }
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "250m",
                    "memory": "256Mi"
                  },
                  "limits": {
                    "cpu": "1500m",
                    "memory": "1Gi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {}
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "policy/v1",
      "kind": "PodDisruptionBudget",
      "metadata": {
        "name": "getdone-web",
        "namespace": "getdone"
      },
      "spec": {
        "minAvailable": 1,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "getdone",
            "app.kubernetes.io/component": "web"
          }
        }
      }
    },
    {
      "apiVersion": "policy/v1",
      "kind": "PodDisruptionBudget",
      "metadata": {
        "name": "getdone-worker",
        "namespace": "getdone"
      },
      "spec": {
        "minAvailable": 1,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "getdone",
            "app.kubernetes.io/component": "worker"
          }
        }
      }
    },
    {
      "apiVersion": "autoscaling/v2",
      "kind": "HorizontalPodAutoscaler",
      "metadata": {
        "name": "getdone-web",
        "namespace": "getdone"
      },
      "spec": {
        "scaleTargetRef": {
          "apiVersion": "apps/v1",
          "kind": "Deployment",
          "name": "getdone-web"
        },
        "minReplicas": 2,
        "maxReplicas": 6,
        "behavior": {
          "scaleDown": {
            "stabilizationWindowSeconds": 300
          },
          "scaleUp": {
            "stabilizationWindowSeconds": 30
          }
        },
        "metrics": [
          {
            "type": "Resource",
            "resource": {
              "name": "cpu",
              "target": {
                "type": "Utilization",
                "averageUtilization": 70
              }
            }
          }
        ]
      }
    },
    {
      "apiVersion": "autoscaling/v2",
      "kind": "HorizontalPodAutoscaler",
      "metadata": {
        "name": "getdone-worker",
        "namespace": "getdone"
      },
      "spec": {
        "scaleTargetRef": {
          "apiVersion": "apps/v1",
          "kind": "Deployment",
          "name": "getdone-worker"
        },
        "minReplicas": 2,
        "maxReplicas": 10,
        "behavior": {
          "scaleDown": {
            "stabilizationWindowSeconds": 300
          },
          "scaleUp": {
            "stabilizationWindowSeconds": 30
          }
        },
        "metrics": [
          {
            "type": "Resource",
            "resource": {
              "name": "cpu",
              "target": {
                "type": "Utilization",
                "averageUtilization": 70
              }
            }
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "Ingress",
      "metadata": {
        "name": "getdone-web",
        "namespace": "getdone",
        "annotations": {
          "kubernetes.io/ingress.class": "nginx",
          "cert-manager.io/cluster-issuer": "letsencrypt-production",
          "nginx.ingress.kubernetes.io/ssl-redirect": "true",
          "nginx.ingress.kubernetes.io/force-ssl-redirect": "true"
        }
      },
      "spec": {
        "tls": [
          {
            "hosts": [
              "__PUBLIC_HOST__"
            ],
            "secretName": "getdone-tls"
          }
        ],
        "rules": [
          {
            "host": "__PUBLIC_HOST__",
            "http": {
              "paths": [
                {
                  "path": "/",
                  "pathType": "Prefix",
                  "backend": {
                    "service": {
                      "name": "getdone-web",
                      "port": {
                        "number": 80
                      }
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "getdone-default-deny",
        "namespace": "getdone"
      },
      "spec": {
        "podSelector": {},
        "policyTypes": [
          "Ingress",
          "Egress"
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "getdone-web-ingress",
        "namespace": "getdone"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "app.kubernetes.io/name": "getdone",
            "app.kubernetes.io/component": "web"
          }
        },
        "policyTypes": [
          "Ingress"
        ],
        "ingress": [
          {
            "from": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "ingress-nginx"
                  }
                }
              }
            ],
            "ports": [
              {
                "protocol": "TCP",
                "port": 3000
              }
            ]
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "getdone-egress",
        "namespace": "getdone"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "app.kubernetes.io/name": "getdone"
          }
        },
        "policyTypes": [
          "Egress"
        ],
        "egress": [
          {
            "to": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "kube-system"
                  }
                }
              }
            ],
            "ports": [
              {
                "protocol": "UDP",
                "port": 53
              },
              {
                "protocol": "TCP",
                "port": 53
              }
            ]
          },
          {
            "to": [
              {
                "ipBlock": {
                  "cidr": "0.0.0.0/0"
                }
              }
            ],
            "ports": [
              {
                "protocol": "TCP",
                "port": 443
              },
              {
                "protocol": "TCP",
                "port": 5432
              }
            ]
          }
        ]
      }
    }
  ]
}
