{
  "schemaVersion": "1.1.0",
  "rules": [
    {
      "id": "resource-internals-private",
      "fromPrefixes": [
        "app/",
        "components/",
        "lib/"
      ],
      "denyImportPrefixes": [
        "@/lib/resources/internal/"
      ],
      "allowFromPrefixes": [
        "lib/resources/internal/",
        "lib/resources/scheduler.ts",
        "lib/resources/reservations.ts"
      ]
    },
    {
      "id": "voice-non-authoritative",
      "fromPrefixes": [
        "lib/voice/"
      ],
      "denyImportPrefixes": [
        "@/lib/authorization/",
        "@/lib/credentials/",
        "@/lib/domain/services/",
        "@/lib/execution/",
        "@/lib/resources/internal/",
        "@/lib/resources/scheduler",
        "@/lib/resources/reservations"
      ],
      "allowFromPrefixes": []
    },
    {
      "id": "ai-gateway-cognition-only",
      "fromPrefixes": [
        "lib/ai-gateway/"
      ],
      "denyImportPrefixes": [
        "@/lib/domain/services/",
        "@/lib/execution/adapters/",
        "@/lib/resources/scheduler",
        "@/lib/resources/reservations",
        "@/lib/credentials/broker"
      ],
      "allowFromPrefixes": []
    },
    {
      "id": "integration-registry-not-execution",
      "fromPrefixes": [
        "lib/integrations/"
      ],
      "denyImportPrefixes": [
        "@/lib/authorization/",
        "@/lib/domain/services/",
        "@/lib/execution/",
        "@/lib/resources/scheduler",
        "@/lib/resources/reservations"
      ],
      "allowFromPrefixes": []
    },
    {
      "id": "business-adapters-cannot-authorize",
      "fromPrefixes": [
        "lib/execution/adapters/"
      ],
      "denyImportPrefixes": [
        "@/lib/authorization/",
        "@/lib/planning/policy-engine",
        "@/lib/domain/services/"
      ],
      "allowFromPrefixes": []
    },
    {
      "id": "frontend-no-execution-authority",
      "fromPrefixes": [
        "components/"
      ],
      "denyImportPrefixes": [
        "@/lib/authorization/",
        "@/lib/credentials/",
        "@/lib/domain/services/",
        "@/lib/execution/",
        "@/lib/resources/internal/"
      ],
      "allowFromPrefixes": []
    },
    {
      "id": "resource-adapters-provider-only",
      "fromPrefixes": [
        "lib/resources/development-mock-resource-adapter.ts"
      ],
      "denyImportPrefixes": [
        "@/lib/authorization/",
        "@/lib/domain/services/",
        "@/lib/planning/policy-engine",
        "@/lib/credentials/broker",
        "@/lib/execution/"
      ],
      "allowFromPrefixes": []
    },
    {
      "id": "resource-pool-storage-resilience-no-business-authority",
      "fromPrefixes": [
        "lib/resources/storage-fabric.ts",
        "lib/resources/resilience.ts",
        "lib/resources/pools.ts",
        "lib/resources/adapter-sdk.ts"
      ],
      "denyImportPrefixes": [
        "@/lib/authorization/",
        "@/lib/domain/services/",
        "@/lib/execution/adapters/",
        "@/lib/voice/"
      ],
      "allowFromPrefixes": []
    },
    {
      "id": "phase44-harness-no-live-provider",
      "fromPrefixes": [
        "lib/security/phase44-adversarial-harness.ts"
      ],
      "denyImportPrefixes": [
        "@/lib/resources/development-mock-resource-adapter",
        "@/lib/ai-gateway/development-mock-adapter",
        "@/lib/integrations/development-mock-adapter",
        "@/lib/execution/adapters/development-mock-business-action"
      ],
      "allowFromPrefixes": []
    }
  ]
}
