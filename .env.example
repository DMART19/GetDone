# Public, non-secret environment label used by the owner UI.
NEXT_PUBLIC_APP_ENV=development

# Development seed data is allowed only outside a production owner surface.
GETDONE_DATA_MODE=development-seed

# Reserved for the future server-authoritative GetDone Control API.
GETDONE_CONTROL_API_URL=

# Auth/database/provider secrets are intentionally NOT represented with example values.
# They must be supplied server-side by the chosen deployment platform once those
# infrastructure decisions are made.
