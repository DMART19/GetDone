# Public, non-secret environment label used only by the owner UI.
# It must never be used to grant server-side authority.
NEXT_PUBLIC_APP_ENV=development

# REQUIRED server-authoritative runtime environment.
# Missing or invalid values fail closed in authoritative server code.
GETDONE_RUNTIME_ENV=development

# Development seed data is allowed only when the server runtime is non-production.
GETDONE_DATA_MODE=development-seed

# Optional URL used by clients when the authoritative Control API is deployed separately.
GETDONE_CONTROL_API_URL=

# PostgreSQL 16+ authoritative persistence. DATABASE_URL is server-only and blank in source control.
# The same adapter layer works with Supabase Postgres, Neon, RDS, or self-hosted PostgreSQL.
DATABASE_URL=
GETDONE_DB_POOL_MAX=10
GETDONE_DB_STATEMENT_TIMEOUT_MS=15000
GETDONE_DB_CONNECTION_TIMEOUT_MS=5000
# Production/staging runtime role created by migration 2026-09-23.1. It is NOBYPASSRLS/NOSUPERUSER.
GETDONE_DB_RUNTIME_ROLE=getdone_tenant_runtime
GETDONE_DB_SSL=true

# Production backup acceptance. These values are server-only.
# GETDONE_BACKUP_REF is an opaque provider backup/restore reference; only its SHA-256 is persisted.
# GETDONE_BACKUP_VERIFICATION_HASH must be the SHA-256 produced by the verified restore procedure.
GETDONE_BACKUP_MAX_AGE_HOURS=24
GETDONE_BACKUP_REF=
GETDONE_BACKUP_VERIFICATION_HASH=
GETDONE_BACKUP_COMPLETED_AT=
GETDONE_BACKUP_EVIDENCE_ID=

# Live OpenRouter adapter configuration. OPENROUTER_API_KEY is server-only and
# intentionally blank in source control. Do not prefix any provider secret with NEXT_PUBLIC_.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=45000
OPENROUTER_MAX_RETRIES=2
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=GetDone
OPENROUTER_CANARY_ENABLED=false
OPENROUTER_CANARY_MODEL=
GETDONE_AI_MODEL_PROFILES_JSON=
GETDONE_AI_ROUTING_POLICY_JSON=
# Ordinary business integrations. JSON contains only server-controlled provider/endpoint
# configuration and credential *references* (for example env:GMAIL_SEND_TOKEN), never raw secrets.
GETDONE_HTTP_ACTIONS_JSON=
GETDONE_WEBHOOK_ACTIONS_JSON=
GETDONE_GMAIL_ACTIONS_JSON=
GETDONE_SLACK_ACTIONS_JSON=
# Example server-side secret variables referenced by the JSON above.
GETDONE_HTTP_ACTION_TOKEN=
GETDONE_WEBHOOK_ACTION_TOKEN=
GETDONE_GMAIL_SEND_TOKEN=
GETDONE_GMAIL_READ_TOKEN=
GETDONE_SLACK_SEND_TOKEN=
GETDONE_SLACK_READ_TOKEN=
GETDONE_INTERNAL_WORKER_TOKEN=

# Dedicated durable Job worker process. Deploy this as a separate service with no public ingress.
# The web process should leave GETDONE_PROCESS_ROLE unset or set it to "web".
GETDONE_PROCESS_ROLE=web
GETDONE_JOB_WORKER_ID=
GETDONE_JOB_POLL_INTERVAL_MS=1000
GETDONE_JOB_ERROR_BACKOFF_MS=5000
GETDONE_JOB_RECOVERY_LIMIT=50
GETDONE_JOB_LEASE_SECONDS=60
GETDONE_JOB_HEARTBEAT_SECONDS=20
GETDONE_JOB_BATCH_SIZE=10
GETDONE_JOB_RETRY_BASE_DELAY_MS=1000
GETDONE_JOB_MAX_ATTEMPTS=5
GETDONE_JOB_RECOVERY_DELAY_MS=1000

# Production passkey / WebAuthn configuration. Server-only.
# RP ID is the relying-party domain (for example: app.getdone.example).
# Origins must be exact HTTPS origins as JSON or a comma-separated list.
GETDONE_WEBAUTHN_RP_ID=
GETDONE_WEBAUTHN_ORIGINS=
GETDONE_AUTH_COOKIE_NAME=getdone_session
GETDONE_STEP_UP_TTL_SECONDS=300
GETDONE_SIGN_IN_CHALLENGE_TTL_SECONDS=300
GETDONE_SESSION_TTL_SECONDS=86400

# Deterministic production bootstrap inputs. Never expose these to browser code.
# Run only after migrations/readiness prerequisites are satisfied:
#   npm run production:bootstrap
# The command provisions identity/scope/passkey/policy state atomically and creates no session.
GETDONE_OWNER_USER_ID=
GETDONE_OWNER_ORGANIZATION_ID=
GETDONE_OWNER_ORGANIZATION_NAME=
GETDONE_OWNER_COMPANY_ID=
GETDONE_OWNER_COMPANY_NAME=
GETDONE_OWNER_PORTFOLIO_ID=
GETDONE_OWNER_PORTFOLIO_NAME=
GETDONE_OWNER_PASSKEY_CREDENTIAL_ID=
GETDONE_OWNER_PASSKEY_PUBLIC_KEY_PEM_B64=
GETDONE_OWNER_PASSKEY_ALGORITHM=ES256
GETDONE_OWNER_PASSKEY_USER_HANDLE=

# Auth/provider credentials must be supplied server-side by the chosen
# deployment/secret platform. Example files may name variables but must not contain values.

# Phase 28 Node enrollment. Server-only; never expose with NEXT_PUBLIC_.
# Keep stable while unconsumed bootstrap challenges exist.
GETDONE_NODE_ENROLLMENT_SECRET=

# Development identity issuer only. Production must install a real CA/mTLS adapter.
GETDONE_NODE_IDENTITY_DEV_SECRET=

# Legacy non-production owner-session helper only. The production bootstrap intentionally
# does not mint a bearer session token.
GETDONE_OWNER_SESSION_TOKEN=
GETDONE_OWNER_SESSION_TTL_HOURS=24
GETDONE_OWNER_SESSION_ID=
