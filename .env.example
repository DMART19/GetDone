# Public, non-secret environment label used only by the owner UI.
# It must never be used to grant server-side authority.
NEXT_PUBLIC_APP_ENV=development

# REQUIRED server-authoritative runtime environment.
# Production startup requires GETDONE_RUNTIME_ENV=production, NODE_ENV=production,
# NEXT_PUBLIC_APP_ENV=production, and GETDONE_DATA_MODE=authoritative.
GETDONE_RUNTIME_ENV=development

# Development seed data is allowed only when the server runtime is non-production.
GETDONE_DATA_MODE=development-seed

# Optional URL used by clients when the authoritative Control API is deployed separately.
GETDONE_CONTROL_API_URL=

# PostgreSQL 16+ authoritative persistence. DATABASE_URL is server-only and blank in source control.
# The same adapter layer works with Supabase Postgres, Neon, RDS, or self-hosted PostgreSQL.
DATABASE_URL=
GETDONE_DB_POOL_MAX=10
GETDONE_DB_STATEMENT_TIMEOUT_MS=15000
GETDONE_DB_CONNECTION_TIMEOUT_MS=5000
# Production/staging runtime role created by migration 2026-09-23.1. It is NOBYPASSRLS/NOSUPERUSER.
GETDONE_DB_RUNTIME_ROLE=getdone_tenant_runtime
GETDONE_DB_SSL=true

# Production backup acceptance. These values are server-only.
# GETDONE_BACKUP_REF is an opaque provider backup/restore reference; only its SHA-256 is persisted.
# GETDONE_BACKUP_VERIFICATION_HASH must be the SHA-256 produced by the verified restore procedure.
GETDONE_BACKUP_MAX_AGE_HOURS=24
GETDONE_BACKUP_REF=
GETDONE_BACKUP_VERIFICATION_HASH=
GETDONE_BACKUP_COMPLETED_AT=
GETDONE_BACKUP_EVIDENCE_ID=

# Live OpenRouter adapter configuration. OPENROUTER_API_KEY is server-only and
# intentionally blank in source control. Do not prefix any provider secret with NEXT_PUBLIC_.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=45000
OPENROUTER_MAX_RETRIES=2
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=GetDone
# Production startup requires the canary enabled and bound to a concrete configured model.
OPENROUTER_CANARY_ENABLED=false
OPENROUTER_CANARY_MODEL=
GETDONE_AI_MODEL_PROFILES_JSON=
GETDONE_AI_ROUTING_POLICY_JSON=
# Optional owner-health monthly company spend ceiling. This is an observability
# threshold derived from persisted AI call audits, not a replacement for request-time budget admission.
GETDONE_AI_MONTHLY_COMPANY_BUDGET_CENTS=

# Secret-backed staging acceptance inputs. Model IDs must be concrete, distinct,
# currently available OpenRouter model IDs; the API key remains secret.
GETDONE_OPENROUTER_PRIMARY_MODEL=
GETDONE_OPENROUTER_FALLBACK_MODEL=
# Ordinary business integrations. JSON contains only server-controlled provider/endpoint
# configuration plus logical credentialProviderId values. Provider secrets never belong here
# and are redeemed from credential leases only at execution time.
GETDONE_HTTP_ACTIONS_JSON=
GETDONE_WEBHOOK_ACTIONS_JSON=
GETDONE_GMAIL_ACTIONS_JSON=
GETDONE_SLACK_ACTIONS_JSON=
# Governed credential delivery service. Ordinary adapters never resolve provider secrets directly.
GETDONE_CREDENTIAL_DELIVERY_URL=
GETDONE_CREDENTIAL_BROKER_TOKEN=
GETDONE_CREDENTIAL_DELIVERY_TIMEOUT_MS=10000
# Ephemeral configured-HTTPS staging acceptance values; CI normally generates these at runtime.
GETDONE_HTTP_STAGING_ORIGIN=
GETDONE_HTTP_STAGING_TOKEN_A=
GETDONE_HTTP_STAGING_TOKEN_B=
GETDONE_HTTP_STAGING_CONTROL_TOKEN=
# Ephemeral live webhook acceptance values are normally generated by CI.
GETDONE_WEBHOOK_STAGING_ORIGIN=
GETDONE_WEBHOOK_STAGING_SIGNING_SECRET=
GETDONE_WEBHOOK_STAGING_CONTROL_TOKEN=
# Protected live Gmail staging acceptance. Prefer a refresh token so the workflow can mint short-lived tokens.
GETDONE_GMAIL_STAGING_CLIENT_ID=
GETDONE_GMAIL_STAGING_CLIENT_SECRET=
GETDONE_GMAIL_STAGING_REFRESH_TOKEN=
GETDONE_GMAIL_STAGING_REVOKED_TOKEN=
GETDONE_GMAIL_STAGING_EMAIL=
# Protected live Slack staging acceptance values.
GETDONE_SLACK_STAGING_BOT_TOKEN=
GETDONE_SLACK_STAGING_READ_TOKEN=
GETDONE_SLACK_STAGING_NO_WRITE_TOKEN=
GETDONE_SLACK_STAGING_REVOKED_TOKEN=
GETDONE_SLACK_STAGING_CHANNEL_ID=
GETDONE_INTERNAL_WORKER_TOKEN=

# Dedicated durable Job worker process. Deploy this as a separate service with no public ingress.
# Production startup requires an explicit process identity: "web" or "job-worker".
GETDONE_PROCESS_ROLE=web
GETDONE_JOB_WORKER_ID=
# Dedicated worker exposes only /livez and /readyz on this private health listener.
GETDONE_JOB_WORKER_HEALTH_HOST=0.0.0.0
GETDONE_JOB_WORKER_HEALTH_PORT=3001
GETDONE_JOB_POLL_INTERVAL_MS=1000
GETDONE_JOB_ERROR_BACKOFF_MS=5000
GETDONE_JOB_RECOVERY_LIMIT=50
GETDONE_JOB_LEASE_SECONDS=60
GETDONE_JOB_HEARTBEAT_SECONDS=20
GETDONE_JOB_BATCH_SIZE=10
# Maximum Jobs actively executed by one worker process at once. Must be <= batch size.
GETDONE_JOB_CONCURRENCY=4
# Pending queue admission limits. Saturation returns a retryable 503 instead of unbounded growth.
GETDONE_JOB_QUEUE_DEPTH_LIMIT=1000
GETDONE_JOB_COMPANY_QUEUE_DEPTH_LIMIT=250
# Provider concurrency is enforced across worker processes using expiring PostgreSQL permits.
# JSON keys are exact business-action adapter IDs and override the default.
GETDONE_PROVIDER_CONCURRENCY_LIMIT=4
GETDONE_PROVIDER_CONCURRENCY_LEASE_SECONDS=120
GETDONE_PROVIDER_CONCURRENCY_LIMITS_JSON={}
GETDONE_JOB_RETRY_BASE_DELAY_MS=1000
GETDONE_JOB_MAX_ATTEMPTS=5
GETDONE_JOB_RECOVERY_DELAY_MS=1000

# Production passkey / WebAuthn configuration. Server-only.
# RP ID is the relying-party domain (for example: getdone.example).
# Production origins must be exact HTTPS origins; loopback/localhost is rejected.
GETDONE_WEBAUTHN_RP_ID=
GETDONE_WEBAUTHN_ORIGINS=
GETDONE_AUTH_COOKIE_NAME=getdone_session
GETDONE_STEP_UP_TTL_SECONDS=300
GETDONE_SIGN_IN_CHALLENGE_TTL_SECONDS=300
GETDONE_SESSION_TTL_SECONDS=86400

# Deterministic production bootstrap inputs. Never expose these to browser code.
# Run only after migrations/readiness prerequisites are satisfied:
#   npm run production:bootstrap
# The command provisions identity/scope/passkey/policy state atomically and creates no session.
GETDONE_OWNER_USER_ID=
GETDONE_OWNER_ORGANIZATION_ID=
GETDONE_OWNER_ORGANIZATION_NAME=
GETDONE_OWNER_COMPANY_ID=
GETDONE_OWNER_COMPANY_NAME=
GETDONE_OWNER_PORTFOLIO_ID=
GETDONE_OWNER_PORTFOLIO_NAME=
GETDONE_OWNER_PASSKEY_CREDENTIAL_ID=
GETDONE_OWNER_PASSKEY_PUBLIC_KEY_PEM_B64=
GETDONE_OWNER_PASSKEY_ALGORITHM=ES256
GETDONE_OWNER_PASSKEY_USER_HANDLE=

# Provider credentials are never configured directly on ordinary adapters.
# The governed credential-delivery service supplies short-lived scoped material from leases.
# Provider-specific staging acceptance secrets below remain separate test/deployment inputs.

# Phase 28 Node enrollment. Server-only; never expose with NEXT_PUBLIC_.
# Keep stable while unconsumed bootstrap challenges exist.
GETDONE_NODE_ENROLLMENT_SECRET=

# Development identity issuer only. Production must install a real CA/mTLS adapter.
GETDONE_NODE_IDENTITY_DEV_SECRET=

# Legacy non-production owner-session helper only. The production bootstrap intentionally
# does not mint a bearer session token.
GETDONE_OWNER_SESSION_TOKEN=
GETDONE_OWNER_SESSION_TTL_HOURS=24
GETDONE_OWNER_SESSION_ID=

# Production startup gate:
#   npm run verify:production-runtime
# The Node server runs this same validator automatically before production services start.
# It requires healthy PostgreSQL + fresh verified backup evidence, production WebAuthn,
# worker authentication, primary/fallback AI routing with live-canary configuration,
# at least one governed production integration, and no development-only runtime settings.
